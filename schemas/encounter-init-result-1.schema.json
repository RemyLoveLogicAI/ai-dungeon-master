{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RemyLoveLogicAI/ai-dungeon-master/main/schemas/encounter-init-result-1.schema.json",
  "title": "encounter-init-result/1",
  "description": "Proposed projection of the engine's run_encounter result; excludes replay logs and campaign persistence.",
  "type": "object",
  "required": ["version", "outcome", "rounds", "xp_awarded", "narrative", "party", "enemies"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "encounter-init-result/1" },
    "outcome": { "enum": ["victory", "mercy_rule", "stalemate"] },
    "rounds": { "type": "integer", "minimum": 0, "maximum": 500 },
    "xp_awarded": { "type": "integer", "minimum": 0, "maximum": 64000000 },
    "narrative": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "party": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/combatantState" } },
    "enemies": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/combatantState" } }
  },
  "$defs": {
    "combatantState": {
      "type": "object",
      "required": ["name", "hp", "ac", "attack_modifier", "damage", "cr", "xp", "stance"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "hp": { "type": "object", "required": ["current", "max"], "additionalProperties": false, "properties": {
          "current": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "max": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "formula": { "type": "string", "maxLength": 100 }
        }},
        "ac": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ac_source": { "type": "string", "maxLength": 100 },
        "attack_modifier": { "type": "integer", "minimum": -100, "maximum": 100 },
        "damage": { "type": "object", "required": ["dice", "sides", "modifier", "type"], "additionalProperties": false, "properties": {
          "dice": { "type": "integer", "minimum": 1, "maximum": 100 },
          "sides": { "type": "integer", "minimum": 1, "maximum": 100 },
          "modifier": { "type": "integer", "minimum": -100, "maximum": 100 },
          "type": { "enum": ["slashing", "piercing", "bludgeoning", "fire", "cold", "lightning", "thunder", "poison", "acid", "psychic", "radiant", "necrotic", "force", "Slashing", "Piercing", "Bludgeoning", "Fire", "Cold", "Lightning", "Thunder", "Poison", "Acid", "Psychic", "Radiant", "Necrotic", "Force"] }
        }},
        "abilities": { "type": "object", "additionalProperties": false, "properties": {
          "str": { "$ref": "#/$defs/abilityValue" }, "dex": { "$ref": "#/$defs/abilityValue" },
          "con": { "$ref": "#/$defs/abilityValue" }, "int": { "$ref": "#/$defs/abilityValue" },
          "wis": { "$ref": "#/$defs/abilityValue" }, "cha": { "$ref": "#/$defs/abilityValue" }
        }},
        "cr": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "string", "maxLength": 10, "pattern": "^[0-9]+(/[0-9]+)?$" }] },
        "xp": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "stance": { "type": "string", "minLength": 1, "maxLength": 50 },
        "initiative": { "type": "integer", "minimum": -50, "maximum": 50 }
      }
    },
    "abilityValue": { "anyOf": [
      { "type": "integer", "minimum": 1, "maximum": 30 },
      { "type": "object", "required": ["score"], "additionalProperties": false, "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 30 },
        "mod": { "type": "integer", "minimum": -10, "maximum": 10 }
      }}
    ]}
  }
}
